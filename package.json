{
  "name": "agentable",
  "private": true,
  "version": "0.0.0",
  "description": "A component library that registers itself with the agent. WebMCP-native, budget-managed.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "dev": "pnpm --filter @agentable-ui/site run dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:conformance": "pnpm run build && pnpm --filter @agentable-ui/conformance run test",
    "conformance:report": "pnpm --filter @agentable-ui/conformance run report",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^24.0.0",
    "happy-dom": "^20.14.0",
    "tsdown": "^0.23.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
