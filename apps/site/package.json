{
  "name": "@agentable-ui/site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-llms.mjs && vite",
    "build": "pnpm --filter \"@agentable-ui/site^...\" run build && node scripts/build-llms.mjs && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@agentable-ui/core": "workspace:^",
    "@agentable-ui/devtools": "workspace:^",
    "@agentable-ui/genui": "workspace:^",
    "@agentable-ui/lang": "workspace:^",
    "@agentable-ui/react": "workspace:^",
    "@agentable-ui/ui": "workspace:^",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2"
  }
}
