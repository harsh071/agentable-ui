{
  "name": "@agentable-ui/core",
  "version": "0.1.1",
  "description": "Framework-free WebMCP capability registry: tiers, budgeter, cache, output shaper, adapters.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./adapters/webmcp": { "types": "./dist/adapters/webmcp.d.ts", "default": "./dist/adapters/webmcp.js" },
    "./adapters/memory": { "types": "./dist/adapters/memory.d.ts", "default": "./dist/adapters/memory.js" },
    "./adapters/bridge": { "types": "./dist/adapters/bridge.d.ts", "default": "./dist/adapters/bridge.js" }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "repository": { "type": "git", "url": "https://github.com/harsh071/agentable-ui", "directory": "packages/core" },
  "keywords": ["webmcp", "agent", "mcp", "components", "react", "modelContext"],
  "publishConfig": { "access": "public" }
}
