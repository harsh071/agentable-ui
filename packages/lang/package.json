{
  "name": "@agentable-ui/lang",
  "version": "0.3.0",
  "description": "Agentable Lang: a compact, streaming-first language for model-generated UI. Parser, streaming parser, prompt generation and serializer, framework-free.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "repository": { "type": "git", "url": "https://github.com/harsh071/agentable-ui", "directory": "packages/lang" },
  "keywords": ["generative-ui", "genui", "webmcp", "agent", "mcp", "components", "react", "streaming"],
  "publishConfig": { "access": "public" },
  "dependencies": { "@agentable-ui/core": "workspace:^" }
}
