{
  "name": "@agentable-ui/genui",
  "version": "0.3.0",
  "description": "Generative UI for Agentable: a streaming Renderer for Agentable Lang programs, AgentSurface with a single validated present tool, catalog schema generation.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "repository": { "type": "git", "url": "https://github.com/harsh071/agentable-ui", "directory": "packages/genui" },
  "keywords": ["webmcp", "agent", "mcp", "components", "react", "modelContext"],
  "publishConfig": { "access": "public" },
  "dependencies": { "@agentable-ui/core": "workspace:^", "@agentable-ui/react": "workspace:^", "@agentable-ui/lang": "workspace:^" },
  "peerDependencies": { "react": "^18.2.0 || ^19.0.0" },
  "devDependencies": { "react": "^19.2.8", "react-dom": "^19.2.8", "@types/react": "^19.2.18", "@types/react-dom": "^19.2.7", "@testing-library/react": "^16.3.3", "@agentable-ui/ui": "workspace:^" }
}
